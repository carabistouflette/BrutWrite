{
  "name": "brutwrite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.28.5 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest",
    "test:run": "vitest run",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . && cargo +stable fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo +stable fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-fs": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-focus": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-mention": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "@tiptap/vue-3": "^3.31.4",
    "d3": "^7.9.0",
    "diff-match-patch": "^1.0.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "marked": "^18.1.1",
    "pdfjs-dist": "^6.4.299",
    "pinia": "^4.0.3",
    "tippy.js": "^6.3.7",
    "vis-data": "^8.0.5",
    "vis-timeline": "^8.5.4",
    "vue": "^3.5.43",
    "vue-draggable-next": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tauri-apps/cli": "^2.12.2",
    "@types/d3": "^7.4.3",
    "@types/diff-match-patch": "^1.0.36",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.29",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --fix",
    "*.{json,md,css,scss}": "prettier --write"
  }
}
